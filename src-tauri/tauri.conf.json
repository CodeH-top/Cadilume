{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cadilume",
  "version": "0.2.0",
  "identifier": "top.codeh.cadilume",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cadilume",
        "width": 1280,
        "height": 820,
        "visible": false,
        "minWidth": 1280,
        "minHeight": 820,
        "center": true,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "shadow": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 28
        },
        "backgroundThrottling": "disabled",
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: blob: https://plex.tv https://*.plex.tv http://127.0.0.1:*; media-src 'self' blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "轻量、桌面友好的 Plex 音乐播放器",
    "longDescription": "连接你有权访问的 Plex 音乐资料库，提供独立音量、桌面队列、系统窗口和明确退出入口。",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwQzNCMkI1NDYzQTA0N0YKUldSL0JEcEd0YkxEWUhNMjc1SHFCVmFqakdlOTQ1Q0ZjU0JJbm02YTNIRFR3SnV2bkN3YkJNNFQK",
      "endpoints": [
        "https://github.com/CodeH-top/Cadilume/releases/latest/download/latest.json"
      ]
    }
  }
}
