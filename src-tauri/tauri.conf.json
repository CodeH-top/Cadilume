{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cadilume",
  "version": "0.1.1",
  "identifier": "top.codeh.cadilume",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Cadilume",
        "width": 960,
        "height": 640,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": true,
        "backgroundThrottling": "disabled",
        "fullscreen": false
      },
      {
        "label": "desktop-lyrics",
        "title": "Cadilume 桌面歌词",
        "url": "index.html#/desktop-lyrics",
        "width": 820,
        "height": 168,
        "center": true,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: blob: https://plex.tv https://*.plex.tv http://127.0.0.1:*; media-src 'self' blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "轻量、桌面友好的 Plex 音乐播放器",
    "longDescription": "连接你有权访问的 Plex 音乐资料库，提供独立音量、桌面队列、系统窗口和明确退出入口。",
    "resources": {
      "icons/Assets.car": "Assets.car"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
